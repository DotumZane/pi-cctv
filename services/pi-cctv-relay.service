[Unit]
Description=Pi CCTV local camera RTSP relay
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/pi-cctv-mediamtx /etc/pi-cctv/relay.yml
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
