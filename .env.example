# Use a long random value in the real .env file.
CCTV_ADMIN_TOKEN=replace-with-a-long-random-admin-token
CCTV_READ_TOKEN=replace-with-a-long-random-read-only-token
CCTV_BOOTSTRAP_TOKEN=replace-with-a-short-lived-enrollment-token
CCTV_PUBLIC_MEDIA_URL=http://SERVER_IP:8888
CCTV_PUBLIC_WEBRTC_URL=http://SERVER_IP:8889

# Optional local HTTPS for secure device enrollment and server-managed setup Wi-Fi.
# Generate certificates with scripts/generate-local-tls.sh, then set both paths.
CCTV_TLS_DIR=/etc/pi-cctv/tls
CCTV_TLS_CERT=/run/pi-cctv/tls/server.crt
CCTV_TLS_KEY=/run/pi-cctv/tls/server.key
CCTV_TLS_CA_CERT=/run/pi-cctv/tls/ca.crt
CCTV_SETUP_AP_ENABLED=false
CCTV_SETUP_AP_SSID=PiCCTV-Setup
CCTV_SETUP_AP_PASSWORD=replace-with-a-unique-shared-wifi-password
CCTV_SETUP_AP_COUNTRY=US
CCTV_SETUP_AP_CHANNEL=6
# Increment this value when rotating the Wi-Fi profile.
CCTV_SETUP_AP_REVISION=1
